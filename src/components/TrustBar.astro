---
import Icon from './Icon.astro';
const items = [
  { icon: 'check', text: 'Diagnóstico gratuito, sin compromiso' },
  { icon: 'pin', text: 'Equipo en Barranquilla, Colombia, cerca y rápido' },
  { icon: 'layers', text: 'Un solo equipo para web, SEO, anuncios, contenido y automatización' },
  { icon: 'chart', text: 'Todo medido: sabes qué funciona y qué no' },
];
---
<section class="trust" aria-label="Por qué confiar en SiFunnel" data-section="confianza">
  <div class="container">
    <ul role="list" class="trust-list stagger">
      {items.map((it) => (
        <li>
          <span class="ti"><Icon name={it.icon} size={18} /></span>
          <span>{it.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust {
    border-block: 1px solid rgba(72, 69, 85, 0.5);
    background: linear-gradient(180deg, rgba(21, 27, 42, 0.6), rgba(7, 14, 28, 0.6));
    padding-block: 26px;
  }
  .trust-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px 28px; }
  .trust-list li { display: flex; gap: 12px; align-items: center; font-size: 0.92rem; color: var(--on-surface-variant); line-height: 1.4; }
  .ti {
    flex: none; display: grid; place-items: center;
    width: 34px; height: 34px; border-radius: 10px;
    background: rgba(65, 229, 117, 0.1); color: var(--secondary);
    border: 1px solid rgba(65, 229, 117, 0.25);
  }
  @media (max-width: 960px) { .trust-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .trust-list { grid-template-columns: 1fr; } }
</style>
