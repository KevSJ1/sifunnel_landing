---
const team = [
  {
    name: 'Kevin Sanchez',
    role: 'Líder técnico',
    photo: '/KevinSanchez.jpeg',
  },
  {
    name: 'Maria José Martinez',
    role: 'Coordinadora de proyectos',
    photo: '/MariaJoseMArtinez.jpeg',
  },
];
---
<section id="equipo" class="section section--alt" data-section="equipo" aria-labelledby="team-title">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow">El equipo detrás de SiFunnel</p>
      <h2 id="team-title" class="h2">Personas reales, trabajando contigo.</h2>
      <p class="lead">Unimos tecnología y coordinación para que cada parte de tu estrategia avance en la misma dirección.</p>
    </div>

    <ul class="team-grid stagger" role="list">
      {team.map((member) => (
        <li class="team-card card">
          <img
            class="team-photo"
            src={member.photo}
            alt={`Retrato de ${member.name}`}
            width="480"
            height="480"
            loading="lazy"
            decoding="async"
          />
          <div class="team-info">
            <h3 class="h3">{member.name}</h3>
            <p class="team-role">{member.role}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-head { max-width: 680px; }
  .section-head .lead { margin-top: 16px; }
  .team-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(20px, 4vw, 36px); max-width: 900px; margin-inline: auto; }
  .team-card { overflow: hidden; padding: 0; }
  .team-photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: center 35%; }
  .team-info { padding: 24px clamp(20px, 4vw, 32px) 28px; }
  .team-role { margin-top: 4px; color: var(--primary); font-weight: 600; }

  @media (max-width: 640px) {
    .team-grid { grid-template-columns: 1fr; max-width: 440px; }
  }
</style>
