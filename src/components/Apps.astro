---
import Icon from './Icon.astro';
import { apps, wa } from '../data/site';
---
<section id="apps" class="section section--alt" data-section="apps" aria-labelledby="apps-title">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow">Nuestras apps</p>
      <h2 id="apps-title" class="h2">Software listo para usar, con suscripción mensual.</h2>
      <p class="lead">Sin comprar licencias ni instalar nada: pagas mes a mes y lo usas desde el primer día.</p>
    </div>

    <div class="apps stagger">
      {apps.map((a) => (
        <article class="card app spotlight" id={`app-${a.id}`}>
          <span class="app-icon"><Icon name={a.icon} size={28} /></span>
          <h3 class="h3">{a.name}</h3>
          <p class="app-tag">{a.tagline}</p>
          <ul role="list" class="app-list">
            {a.bullets.map((b) => <li><Icon name="check" size={16} /> <span>{b}</span></li>)}
          </ul>
          <div class="app-price">
            {a.price
              ? <p><strong>{a.price}</strong> <span>{a.period}</span></p>
              : <p><strong>Precio por WhatsApp</strong></p>}
            <p class="app-note">{a.note}</p>
          </div>
          <div class="app-links">
            <a class="btn btn-wa" href={wa(a.msg)} target="_blank" rel="noopener" data-wa data-service={`app-${a.id}`}>
              <Icon name="whatsapp" />
              <span>{a.price ? 'Suscribirme' : 'Quiero suscribirme'}</span>
            </a>
            {a.url && <a class="link-arrow" href={a.url} target="_blank" rel="noopener">Ver más <Icon name="arrow" size={18} /></a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .lead { margin-top: 16px; }
  .apps { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .app { display: flex; flex-direction: column; gap: 14px; }
  .app-icon {
    display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px;
    color: var(--primary); background: rgba(202, 190, 255, 0.12); border: 1px solid rgba(202, 190, 255, 0.3);
  }
  .app-tag { color: var(--on-surface-variant); }
  .app-list { display: grid; gap: 8px; font-size: 0.93rem; }
  .app-list li { display: flex; gap: 10px; align-items: flex-start; }
  .app-list :global(svg) { flex: none; margin-top: 4px; color: var(--secondary); }
  .app-price { padding-block: 14px; border-block: 1px solid rgba(72, 69, 85, 0.6); margin-top: auto; }
  .app-price strong { font: 700 1.5rem var(--font-display); color: var(--primary); }
  .app-price span { color: var(--on-surface-variant); font-size: 0.92rem; }
  .app-note { margin-top: 4px; font-size: 0.85rem; color: var(--on-surface-variant); }
  .app-links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; }
  @media (max-width: 860px) { .apps { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; } }
</style>
