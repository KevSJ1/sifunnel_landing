---
import Icon from './Icon.astro';
import { site, wa } from '../data/site';

type V = boolean | string;
const content: V = site.captacionIncludesContent === null ? 'Según diagnóstico' : site.captacionIncludesContent;
const features: { name: string; v: [V, V, V] }[] = [
  { name: 'Mejora de presencia digital', v: [true, true, true] },
  { name: 'SEO técnico y local', v: ['Básico', true, true] },
  { name: 'Página web / landing que convierte', v: [false, true, true] },
  { name: 'Estrategia de anuncios', v: [false, true, true] },
  { name: 'Contenido con IA', v: [false, content, true] },
  { name: 'Agente IA en WhatsApp + CRM', v: [false, false, true] },
  { name: 'Analítica y reporte mensual', v: [false, true, true] },
];
const plans = [
  { key: 'presencia', name: 'Presencia', for: 'Verte profesional y que te encuentren', price: site.prices.presencia },
  { key: 'captacion', name: 'Captación', for: 'Atraer clientes y convertirlos', price: site.prices.captacion, featured: true },
  { key: 'completo', name: 'Sistema completo', for: 'Todo el embudo conectado y medido', price: site.prices.completo },
];
---
<section id="planes" class="section" data-section="planes" aria-labelledby="planes-title">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow">Planes</p>
      <h2 id="planes-title" class="h2">Empieza por lo que más necesitas. Crece cuando estés listo.</h2>
      <p class="lead">Los planes se arman por etapa del embudo. Cada servicio también se puede contratar por separado.</p>
    </div>

    <div class="plans stagger">
      {plans.map((p, pi) => (
        <article class:list={['plan', p.featured && 'plan--featured']}>
          {p.featured && <span class="tag">Recomendado</span>}
          <h3 class="plan-name">{p.name}</h3>
          <p class="plan-for">{p.for}</p>
          <p class="plan-price">{p.price ?? 'Precio exacto en el diagnóstico'}</p>
          <ul role="list" class="feat">
            {features.map((f) => {
              const v = f.v[pi];
              return (
                <li class:list={[v === false && 'off']}>
                  {v === false ? <Icon name="x" size={16} /> : <Icon name="check" size={16} />}
                  <span>
                    {f.name}
                    {typeof v === 'string' && <em> · {v}</em>}
                  </span>
                  {v === false && <span class="sr-only">(no incluido)</span>}
                </li>
              );
            })}
          </ul>
          <a class:list={['btn', p.featured ? 'btn-wa' : 'btn-ghost']} href={wa(`Hola, me interesa el plan ${p.name.toUpperCase()}`)} target="_blank" rel="noopener" data-wa data-service={`plan-${p.key}`}>
            {p.featured && <Icon name="whatsapp" />}
            <span>Me interesa este plan</span>
          </a>
        </article>
      ))}
    </div>

    <p class="plans-foot reveal">
      {site.prices.individualFrom
        ? <>Servicios individuales desde <strong>{site.prices.individualFrom}</strong>.</>
        : <>Te damos el precio exacto en el diagnóstico, <strong>sin compromiso.</strong></>}
      {' '}<a class="link-arrow" href={wa('Hola, quiero saber cuál PLAN me conviene')} target="_blank" rel="noopener" data-wa data-service="planes">Ver cuál plan me conviene <Icon name="arrow" size={18} /></a>
    </p>
  </div>
</section>

<style>
  .lead { margin-top: 16px; }
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; }
  .plan {
    position: relative;
    display: flex; flex-direction: column; gap: 14px;
    padding: clamp(24px, 3vw, 34px);
    border-radius: var(--radius-xl);
    background: var(--surface-low);
    border: 1px solid rgba(72, 69, 85, 0.7);
    transition: transform 0.5s var(--ease-out), border-color 0.3s;
  }
  .plan:hover { transform: translateY(-6px); border-color: var(--outline-variant); }
  .plan--featured {
    background:
      linear-gradient(var(--surface-c), var(--surface-c)) padding-box,
      conic-gradient(from var(--ang, 0deg), var(--primary-container), var(--secondary), var(--primary), var(--primary-container)) border-box;
    border: 1.5px solid transparent;
    box-shadow: 0 30px 80px -30px rgba(148, 125, 255, 0.55);
    animation: spin-border 6s linear infinite;
  }
  @property --ang { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  @keyframes spin-border { to { --ang: 360deg; } }

  .tag {
    position: absolute; top: -13px; left: 50%; translate: -50% 0;
    padding: 5px 14px; border-radius: 9999px;
    background: var(--primary); color: #1c0062;
    font: 700 0.75rem var(--font-body); letter-spacing: 0.06em; text-transform: uppercase;
  }
  .plan-name { font: 700 1.5rem var(--font-display); }
  .plan-for { color: var(--on-surface-variant); min-height: 3.2em; }
  .plan-price {
    font: 700 1.05rem var(--font-display); color: var(--primary);
    padding-block: 14px; border-block: 1px solid rgba(72, 69, 85, 0.6);
  }
  .feat { display: grid; gap: 10px; font-size: 0.93rem; margin-bottom: 10px; }
  .feat li { display: flex; gap: 10px; align-items: flex-start; }
  .feat :global(svg) { flex: none; margin-top: 4px; color: var(--secondary); }
  .feat em { color: var(--tertiary); font-style: normal; font-weight: 600; }
  .feat .off { color: var(--outline); opacity: 0.6; }
  .feat .off :global(svg) { color: var(--outline); }
  .plan .btn { margin-top: auto; }
  .plans-foot { margin-top: 40px; text-align: center; color: var(--on-surface-variant); display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 16px; align-items: center; }

  @media (max-width: 960px) {
    .plans { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
    .plan-for { min-height: 0; }
  }
</style>
