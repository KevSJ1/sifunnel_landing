---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { wa } from '../data/site';

const links = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#apps', label: 'Apps' },
  { href: '/#planes', label: 'Planes' },
  { href: '/#preguntas', label: 'Preguntas' },
];
---
<header class="header" data-header data-section="header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="SiFunnel, inicio">
      <Logo size={34} animated />
    </a>
    <nav aria-label="Principal" class="nav">
      <ul role="list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-wa header-cta" href={wa()} target="_blank" rel="noopener" data-wa data-service="diagnostico">
      <Icon name="whatsapp" size={20} />
      <span>Diagnóstico gratis</span>
    </a>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-block: 14px;
    transition: background-color 0.4s, backdrop-filter 0.4s, padding 0.4s var(--ease-out), border-color 0.4s;
    border-bottom: 1px solid transparent;
  }
  .header:global(.is-scrolled) {
    padding-block: 10px;
    background: rgba(12, 19, 33, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: rgba(72, 69, 85, 0.5);
  }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .nav ul { display: flex; gap: 4px; }
  .nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 9999px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--on-surface-variant);
    transition: color 0.2s, background-color 0.2s;
  }
  .nav a:hover { color: var(--on-surface); background: rgba(202, 190, 255, 0.08); }
  .header-cta { min-height: 44px; padding: 10px 18px; font-size: 0.92rem; }
  .header-cta :global(svg) { width: 20px; height: 20px; }

  @media (max-width: 960px) { .nav { display: none; } }
  @media (max-width: 420px) {
    .header-cta span { display: none; }
    .header-cta { padding: 10px 12px; }
  }
</style>
