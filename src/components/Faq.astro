---
import { getFaqs } from '../data/site';
const faqs = getFaqs();
---
<section id="preguntas" class="section" data-section="faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div class="reveal faq-head">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2 id="faq-title" class="h2">Lo que nos preguntan antes de empezar.</h2>
    </div>
    <div class="faq stagger">
      {faqs.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            <h3>{f.q}</h3>
            <span class="pm" aria-hidden="true"></span>
          </summary>
          <div class="answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .faq-head { position: sticky; top: 110px; }
  .faq { display: grid; gap: 10px; }
  details {
    border-radius: var(--radius-md);
    background: var(--surface-low);
    border: 1px solid rgba(72, 69, 85, 0.6);
    transition: border-color 0.3s, background-color 0.3s;
  }
  details[open] { border-color: rgba(148, 125, 255, 0.45); background: var(--surface-c); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 20px 22px; cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font: 600 1.05rem/1.4 var(--font-display); }
  .pm { position: relative; flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--surface-highest); }
  .pm::before, .pm::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; border-radius: 2px;
    background: var(--primary); translate: -50% -50%;
    transition: transform 0.4s var(--ease-spring);
  }
  .pm::after { transform: rotate(90deg); }
  details[open] .pm::after { transform: rotate(0deg); }
  .answer { padding: 0 22px 22px; color: var(--on-surface-variant); }

  /* Apertura animada donde el navegador lo soporta */
  @supports (interpolate-size: allow-keywords) {
    :root { interpolate-size: allow-keywords; }
    details::details-content { block-size: 0; overflow: hidden; transition: block-size 0.45s var(--ease-out), content-visibility 0.45s allow-discrete; }
    details[open]::details-content { block-size: auto; }
  }

  @media (max-width: 860px) {
    .faq-grid { grid-template-columns: 1fr; }
    .faq-head { position: static; }
  }
</style>
