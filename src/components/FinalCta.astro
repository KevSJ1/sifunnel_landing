---
import WaButton from './WaButton.astro';
import Logo from './Logo.astro';
import { site } from '../data/site';
---
<section id="diagnostico" class="final" data-section="cta-final" aria-labelledby="final-title">
  <div class="rings" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="container final-inner reveal reveal--scale">
    <Logo size={72} withText={false} animated class="final-logo" />
    <h2 id="final-title" class="h2">Tu competencia ya está invirtiendo en digital. <span class="text-gradient">¿Tu negocio está listo para ganarle?</span></h2>
    <p class="lead">
      En 30 minutos revisamos tu web, tu Google, tus redes y tu WhatsApp, y te decimos qué arreglar primero para conseguir más clientes. Gratis y sin compromiso.
    </p>
    <WaButton label="Solicitar mi diagnóstico gratuito por WhatsApp" size="lg" message="Hola, quiero solicitar mi DIAGNÓSTICO gratuito" />
    {site.responseTime && <p class="micro">Respondemos {site.responseTime}.</p>}
  </div>
</section>

<style>
  .final {
    position: relative; overflow: hidden; isolation: isolate;
    padding-block: clamp(80px, 12vw, 150px);
    background:
      radial-gradient(60% 70% at 50% 100%, rgba(148, 125, 255, 0.28), transparent 70%),
      radial-gradient(40% 50% at 50% 0%, rgba(65, 229, 117, 0.08), transparent 70%),
      var(--surface-lowest);
    border-top: 1px solid rgba(72, 69, 85, 0.5);
  }
  .rings { position: absolute; inset: 0; z-index: -1; display: grid; place-items: center; pointer-events: none; }
  .rings span {
    grid-area: 1 / 1;
    width: 340px; aspect-ratio: 1; border-radius: 50%;
    border: 1px solid rgba(202, 190, 255, 0.18);
    animation: ring 6s var(--ease-out) infinite;
  }
  .rings span:nth-child(2) { animation-delay: 2s; }
  .rings span:nth-child(3) { animation-delay: 4s; }
  @keyframes ring { from { transform: scale(0.6); opacity: 1; } to { transform: scale(3.2); opacity: 0; } }

  .final-inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; max-width: 880px; }
  .final-inner :global(.final-logo) { filter: drop-shadow(0 0 30px rgba(148, 125, 255, 0.45)); }
  .lead { max-width: 680px; }
  .micro { font-size: 0.88rem; color: var(--outline); }
  @media (max-width: 560px) { .final-inner :global(.btn) { width: 100%; } }
</style>
